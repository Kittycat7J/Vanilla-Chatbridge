# Chatbridge Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# Discord Bot Configuration
# Get these from Discord Developer Portal: https://discord.com/developers
DISCORD_TOKEN=your_bot_token_here
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID
DISCORD_CHAT_CHANNEL=your_channel_id_here
DISCORD_LOG_WEBHOOK=https://discord.com/api/webhooks/YOUR_LOG_WEBHOOK_ID
DISCORD_ADMINS=user_id_1,user_id_2
DISCORD_ADMIN_ROLE=your_role_id_here

# Pterodactyl API Configuration
# These should point to your local Pterodactyl Panel instance
PTERODACTYL_API_KEY=your_api_key_here
PTERODACTYL_API_URL=http://localhost
PTERODACTYL_SERVER_ID=your_server_uuid_here
